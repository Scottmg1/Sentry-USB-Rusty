#!/bin/bash -eu

if [ "${BASH_SOURCE[0]}" != "$0" ]
then
  echo "${BASH_SOURCE[0]} must be executed, not sourced"
  return 1 # shouldn't use exit when sourced
fi

# Unload the module that was loaded by cmdline.txt
modprobe -r g_ether

export LOG_FILE=/mutable/archiveloop.log

# If /mutable is full or the log file isn't openable, truncate it so
# archiveloop can start instead of crash-looping. The no-op redirect
# (`: >>`) opens the file in append mode without writing anything —
# we deliberately don't add a startup marker here because users saw
# the old "test" / "archiveloop starting" probe line as log noise.
# log() itself uses `|| true`, so a transient write failure later
# (e.g. disk-full mid-run) can't crash the script on its own.
if ! : >> "$LOG_FILE" 2>/dev/null; then
  : > "$LOG_FILE" 2>/dev/null || true
fi

function log () {
  echo "$( date ):" "$@" >> "$LOG_FILE" 2>/dev/null || true
  if [[ "$(stat --format="%s" "$LOG_FILE" 2>/dev/null)" -gt 1000000 ]] 2>/dev/null
  then
    local log_file2="${LOG_FILE}.2"
    tail -n 5000 "$LOG_FILE" > "${log_file2}" 2>/dev/null
    mv "$log_file2" "$LOG_FILE" 2>/dev/null || true
    log "(log truncated)"
  fi
}

function log_errors_on_exit {
  log "archiveloop exited with code $1. Recent errors follow"
  # The unit is sentryusb-archive (see crates/setup install_archive_service);
  # this used to read the old teslausb unit, so on a crash the supplementary
  # journal dump was always empty.
  journalctl -n 15 -u sentryusb-archive >> "$LOG_FILE" 2>/dev/null || true
  log "end of errors."
  exit "$1"
}

if [ "${FLOCKED:-}" != "$0" ]
then
  if FLOCKED="$0" flock -en -E 99 "$0" "$0" "$@" || case "$?" in
  99) echo already running
      exit 99
      ;;
  *)  log_errors_on_exit $?
      ;;
  esac
  then
    # success
    log_errors_on_exit 0
  fi
fi

export CAM_MOUNT=/mnt/cam
export MUSIC_MOUNT=/mnt/music

# read the setup variables and define other environment variables and functions
source /root/bin/envsetup.sh

# Make sure awake_stop runs no matter how this script exits — set -e
# is on (bash -eu above), so any unhandled error in archive_clips or
# its helpers would otherwise kill the script before reaching the
# explicit `awake_stop` call after archive_clips. Without this trap
# the BLE radio lock stays held by "keep_awake" until the lock-stale
# check eventually kicks in 24h later (or the Pi reboots), blocking
# the telemetry sampler for the duration.
# Idempotent: awake_stop is safe to call even when keep-awake was
# never started (no lock to remove, services already up).
# awake_stop is Travel Mode-aware internally: it always reaps the
# keep-awake nudge loop and restores the BLE radio, but skips the
# SENTRY_CASE 1/2 "Sentry Mode OFF" command while Travel Mode is on,
# so a crash/restart can't disable the user's Sentry away from home.
# That also covers a mid-cycle toggle: enabling Travel Mode between
# awake_start and awake_stop still kills the nudge loop instead of
# leaving it nudging the car every 5 minutes for the rest of the trip.
trap '/root/bin/awake_stop || true' EXIT

# Reason passed to awake_start so nudge log lines show what is keeping the car awake.
export KEEP_AWAKE_REASON=Archive
# Single global PID file shared with web UI keep-awake. awake_start kills
# any existing nudge loop before starting a new one, so only one BLE
# nudge process runs at a time (prevents hci0 contention).
export KEEP_AWAKE_PID_FILE=/tmp/keep_awake_nudge_pid

# led triggers may have been built as modules, so try
# to load them
if ! grep -q timer "$STATUSLED/trigger"
then
  modprobe ledtrig-timer || log "timer LED trigger unavailable"
fi
if ! grep -q heartbeat "$STATUSLED/trigger"
then
  modprobe ledtrig-heartbeat || log "heartbeat LED trigger unavailable" 
fi

if [ -z "${ARCHIVE_SERVER+x}" ]
then
  case "${ARCHIVE_SYSTEM:-none}" in
    rsync)
      export ARCHIVE_SERVER="$RSYNC_SERVER"
      ;;
    rclone)
      export ARCHIVE_SERVER="8.8.8.8"
      ;;
    none)
      export ARCHIVE_SERVER=localhost
      ;;
    *)
      log "ARCHIVE_SERVER not set"
      exit 1
      ;;
  esac
elif [ "${ARCHIVE_SYSTEM:-none}" = "cifs" ] || [ "${ARCHIVE_SYSTEM:-none}" = "nfs" ]
then
  # For CIFS and NFS
  [[ -n "${SHARE_NAME:-}" && -f /backingfiles/cam_disk.bin ]] && export ARCHIVE_MOUNT=/mnt/archive
  [[ -n "${MUSIC_SHARE_NAME:-}" && -f /backingfiles/music_disk.bin ]] && export MUSIC_ARCHIVE_MOUNT=/mnt/musicarchive
fi

function timestamp () {
  local prefix=${1:-}
  while IFS= read -r line
  do
    echo "$(date): $prefix$line"
  done
}

function fix_errors_in_image () {
  local image="$1"
  log "Running fsck on $image..."
  if ! loopback=$(losetup_find_show -P "$image"); then
    log "ERROR: losetup failed for $image"
    return 1
  fi
  # Use -p repair arg. It works with vfat and exfat.
  /sbin/fsck "${loopback}p1" -- -p |& timestamp '| ' >> "$LOG_FILE" || echo ""
  if ! losetup -d "$loopback"; then
    log "WARNING: failed to detach loopback $loopback for $image"
  fi
  log "Finished fsck on $image."
}

function archive_is_reachable () {
  local reachable=true

  # Travel Mode: relax the probe timeouts to the same values the transfer
  # watchdog in archive-clips.sh uses — a high-latency VPN link can take
  # more than 1s to answer, and the snappy defaults misread "slow" as
  # "offline" (skipping post-archive work, or never starting an archive at
  # all on a working link). Normal mode keeps the 1s defaults so
  # drive-away detection stays fast. An explicit env override still wins.
  if travel_mode_active; then
    ARCHIVE_PING_TIMEOUT="${ARCHIVE_PING_TIMEOUT:-4}" ARCHIVE_SSH_TIMEOUT="${ARCHIVE_SSH_TIMEOUT:-8}" \
      /root/bin/archive-is-reachable.sh "$ARCHIVE_SERVER" || reachable=false
  else
    /root/bin/archive-is-reachable.sh "$ARCHIVE_SERVER" || reachable=false
  fi

  if [ "$reachable" = false ]
  then
    false
    return
  fi
  true
}

function sync_user_media_to_cam () {
  local sync_ok=true
  if ! has_cam_disk
  then
    return
  fi
  log "Syncing user media to cam drive..."

  # Wraps & LicensePlate live as folders on the cam drive (no dedicated partition).
  if ensure_mountpoint_is_mounted "$CAM_MOUNT"
  then
    if [ -d "$CAM_WRAPS_PATH" ]
    then
      mkdir -p "$CAM_MOUNT/Wraps"
      if rsync -a --delete "$CAM_WRAPS_PATH/" "$CAM_MOUNT/Wraps/" >> "$LOG_FILE" 2>&1
      then
        # Forward-sync propagated deletions to disk; tombstones no longer needed.
        rm -rf "$CAM_WRAPS_DELETED_PATH" 2>/dev/null || true
      else
        log "Failed to sync Wraps to cam drive"
        sync_ok=false
      fi
    fi
    # LicensePlate has no deletion tombstones; an empty host directory is not
    # authoritative because reverse sync may still restore media from cam.
    if [ -d "$CAM_LICENSE_PLATE_PATH" ] && [ -n "$(ls -A "$CAM_LICENSE_PLATE_PATH" 2>/dev/null)" ]
    then
      mkdir -p "$CAM_MOUNT/LicensePlate"
      if ! rsync -a --delete "$CAM_LICENSE_PLATE_PATH/" "$CAM_MOUNT/LicensePlate/" >> "$LOG_FILE" 2>&1
      then
        log "Failed to sync LicensePlate to cam drive"
        sync_ok=false
      fi
    fi
    # Sync custom chime targets to the root of the cam drive so Tesla reads
    # them via USB. The staged files include the user's applied volume gain.
    _active_chime_name=""
    if [ -f "/mutable/LockChime/.active_name" ]; then
      _active_chime_name=$(tr -d '\n\r' < "/mutable/LockChime/.active_name")
    fi
    if [ -n "$_active_chime_name" ] && [ -f "/mutable/LockChime.wav" ]
    then
      if cp -f "/mutable/LockChime.wav" "$CAM_MOUNT/LockChime.wav"; then
        log "Synced LockChime.wav ($_active_chime_name) to cam drive"
      else
        log "Failed to sync LockChime.wav to cam drive"
      fi
    else
      # No active lock chime — remove from cam drive if present
      rm -f "$CAM_MOUNT/LockChime.wav" 2>/dev/null || true
    fi

    _ass_chime_name=""
    if [ -f "/mutable/LockChime/.ass_active_name" ]; then
      _ass_chime_name=$(tr -d '\n\r' < "/mutable/LockChime/.ass_active_name")
    fi
    if [ -n "$_ass_chime_name" ] && [ -f "/mutable/ASSChime.wav" ]
    then
      if cp -f "/mutable/ASSChime.wav" "$CAM_MOUNT/ASSChime.wav"; then
        log "Synced ASSChime.wav ($_ass_chime_name) to cam drive"
      else
        log "Failed to sync ASSChime.wav to cam drive"
      fi
    else
      # No active Summon completion chime — remove it from the cam drive.
      rm -f "$CAM_MOUNT/ASSChime.wav" 2>/dev/null || true
    fi
    unmount_mount_point "$CAM_MOUNT"
    log "Done syncing user media."
  else
    log "Could not mount cam drive to sync user media."
    return 1
  fi
  [ "$sync_ok" = true ]
}

function sync_disk_media_to_host () {
  log "Reverse-syncing disk media to host paths..."

  # Reverse-sync Wraps & LicensePlate from the cam drive (the only place
  # they live now — no dedicated wraps partition).
  if [ -e /backingfiles/cam_disk.bin ]
  then
    if ensure_mountpoint_is_mounted "$CAM_MOUNT"
    then
      if [ -d "$CAM_MOUNT/Wraps" ] && [ -n "$(ls -A "$CAM_MOUNT/Wraps" 2>/dev/null)" ]
      then
        mkdir -p /mutable/Wraps
        # Build exclude list from tombstones to prevent resurrection of deleted wraps
        _wraps_exclude_file=$(mktemp)
        if [ -d /mutable/.wraps_deleted ]; then
          for _tombstone in /mutable/.wraps_deleted/*; do
            [ -e "$_tombstone" ] && basename "$_tombstone" >> "$_wraps_exclude_file"
          done
        fi
        rsync -a --ignore-existing --exclude-from="$_wraps_exclude_file" "$CAM_MOUNT/Wraps/" "/mutable/Wraps/" >> "$LOG_FILE" 2>&1 \
          || log "Failed to reverse-sync Wraps from cam drive"
        rm -f "$_wraps_exclude_file"
        log "Reverse-synced Wraps from cam drive to /mutable/Wraps."
      fi
      if [ -d "$CAM_MOUNT/LicensePlate" ] && [ -n "$(ls -A "$CAM_MOUNT/LicensePlate" 2>/dev/null)" ]
      then
        mkdir -p /mutable/LicensePlate
        rsync -a --ignore-existing "$CAM_MOUNT/LicensePlate/" "/mutable/LicensePlate/" >> "$LOG_FILE" 2>&1 \
          || log "Failed to reverse-sync LicensePlate from cam drive"
        log "Reverse-synced LicensePlate from cam drive."
      fi
      unmount_mount_point "$CAM_MOUNT"
    fi
  fi

  # Clear stale autofs mount-option cache files for media disks.
  # These are regenerated on next access. Stale files can cause mount
  # failures after disk images are recreated (wizard re-run / disk wipe).
  for img in music_disk.bin lightshow_disk.bin boombox_disk.bin
  do
    rm -f "/backingfiles/${img}.opts"
  done

  log "Done reverse-syncing disk media to host paths."
}

# Serializes gadget teardown/bring-up between the main loop, the gadget
# stall watchdog, and the Rust server's own gadget cycles (lock-chime
# cam-disk sync, toggle-drives — see crates/usb_gadget/src/cycle_lock.rs).
# Without it one party could re-enable the gadget while another has
# cam_disk.bin mounted for a sync (two writers on one block device —
# filesystem corruption, car stops recording).
GADGET_CYCLE_LOCK=/tmp/sentryusb_gadget_cycle.lock
# Shared with snapshot creation/release while changing the snapshot link farm.
SNAPSHOT_LOCK_DIR=/backingfiles/snapshots
# Contains a digest of host media inventory after a successful full connect.
# Its own mtime is irrelevant, so NTP clock steps cannot make clean media dirty.
CAM_MEDIA_SYNC_STAMP=/tmp/sentryusb_cam_media_sync_stamp
CAM_WRAPS_PATH=${CAM_WRAPS_PATH:-/mutable/Wraps}
CAM_LICENSE_PLATE_PATH=${CAM_LICENSE_PLATE_PATH:-/mutable/LicensePlate}
CAM_WRAPS_DELETED_PATH=${CAM_WRAPS_DELETED_PATH:-/mutable/.wraps_deleted}
CAM_MEDIA_WATCH_PATHS=(
  "$CAM_WRAPS_PATH"
  "$CAM_LICENSE_PLATE_PATH"
)
# Durable: cleanup still owed after a real archive (or short recordings) so
# zero-clip skips cannot permanently drop free-space work across restarts.
CAM_CLEANUP_PENDING=/mutable/sentryusb_cam_cleanup_pending

# Run "$@" holding the gadget-cycle lock. Single definition so the fd
# number and lock path can never drift between call sites — a mismatch
# would silently stop the mutual exclusion.
function with_gadget_lock () {
  (
    flock 209
    "$@"
  ) 209>"$GADGET_CYCLE_LOCK"
}

function connect_usb_drives_to_host() {
  with_gadget_lock connect_usb_drives_to_host_locked
}

function connect_usb_drives_to_host_locked() {
  clear_archive_status
  log "Connecting usb to host..."
  # Always ensure the USB gadget is fully torn down before touching the cam
  # disk image.  If clean_cam_mount was skipped (e.g. archive became
  # unreachable while the car drove away), the gadget is still active and
  # mounting cam_disk.bin for the sync below would give the Pi and the car
  # simultaneous access to the same block device, corrupting the filesystem
  # and causing the Tesla to stop writing dashcam footage.
  if /root/bin/disable_gadget.sh 2>/dev/null; then
    log "Disabled stale USB gadget before sync"
    fix_errors_in_images
  fi
  sync_disk_media_to_host
  # Randomize lock chime BEFORE sync_user_media_to_cam so the fresh random pick
  # (recorded in /mutable/LockChime/.active_name) gets copied into the cam disk
  # during the sync step.
  local port="${SENTRYUSB_PORT:-80}"
  curl -sf -X POST "http://127.0.0.1:${port}/api/lockchime/randomize-on-connect" > /dev/null 2>&1 || true
  if sync_user_media_to_cam
  then
    record_cam_media_sync_success || log "ERROR: failed to record synced user-media inventory"
  else
    rm -f "$CAM_MEDIA_SYNC_STAMP"
    log "ERROR: user-media sync failed; leaving inventory dirty for retry"
  fi
  # Pre-trigger autofs mounts for media directories while disk images
  # are free (before the gadget takes over). This ensures the web UI
  # can display Music/LightShow/Boombox files immediately after boot.
  for d in Music LightShow Boombox
  do
    ls "/var/www/html/fs/$d" > /dev/null 2>&1 || true
  done
  if ! /root/bin/enable_gadget.sh; then
    log "ERROR: enable_gadget.sh failed (exit $?)"
  fi
  log "Connected usb to host."
  sleep 5
}

# Inventory digest of watched host media: relative path, type, size, mtime.
# The digest value is stable across wall-clock corrections because comparison
# does not use the state file's own timestamp.
function host_cam_media_generation () {
  local root manifest digest any=false
  manifest=$(mktemp) || { printf 'none\n'; return 0; }

  for root in "${CAM_MEDIA_WATCH_PATHS[@]}"
  do
    if [ -d "$root" ]
    then
      any=true
      printf 'root:%s\n' "$root" >> "$manifest"
      find "$root" \( -type f -o -type l -o -type d \) \
        -printf '%P\t%y\t%s\t%T@\n' 2>/dev/null \
        | LC_ALL=C sort >> "$manifest" || true
    elif [ -e "$root" ]
    then
      any=true
      find "$root" -maxdepth 0 \
        -printf 'file:%p\t%y\t%s\t%T@\n' 2>/dev/null >> "$manifest" || true
    fi
  done

  if [ "$any" != true ]
  then
    rm -f "$manifest"
    printf 'none\n'
    return 0
  fi
  digest=$(sha256sum "$manifest" 2>/dev/null | awk '{print $1}')
  rm -f "$manifest"
  if [ -n "$digest" ]
  then
    printf '%s\n' "$digest"
  else
    printf 'none\n'
  fi
}

function record_cam_media_sync_success () {
  local generation tmp
  generation=$(host_cam_media_generation)
  tmp="${CAM_MEDIA_SYNC_STAMP}.new"
  if printf '%s\n' "$generation" > "$tmp" && mv "$tmp" "$CAM_MEDIA_SYNC_STAMP"
  then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Clock-independent dirty check for Wraps/LicensePlate. LockChime is owned by
# the Rust API's immediate cam cycle on activate/clear.
function cam_user_media_may_need_sync () {
  local current recorded
  current=$(host_cam_media_generation)

  if [ -r "$CAM_MEDIA_SYNC_STAMP" ]
  then
    read -r recorded < "$CAM_MEDIA_SYNC_STAMP" || return 0
    if [ "$current" != "$recorded" ]
    then
      return 0
    fi
  elif [ "$current" != "none" ]
  then
    return 0
  fi
  return 1
}

# Idempotent reconnect: full connect only when inactive or host media dirty.
# Unlike connect_usb_drives_to_host, does not cycle a healthy presentation.
function ensure_usb_drives_connected () {
  with_gadget_lock ensure_usb_drives_connected_locked
}

function ensure_usb_drives_connected_locked () {
  if cam_user_media_may_need_sync
  then
    log "User media changed; cycling gadget once to sync cam image"
    connect_usb_drives_to_host_locked
  elif ! usb_gadget_is_active
  then
    log "USB gadget inactive; synchronising and re-presenting once"
    connect_usb_drives_to_host_locked
  else
    log "USB gadget already active; skipping redundant reconnect"
  fi
}

function mark_cam_cleanup_pending () {
  local parent tmp
  parent=${CAM_CLEANUP_PENDING%/*}
  tmp="${CAM_CLEANUP_PENDING}.new"
  if ! printf 'pending\n' > "$tmp"
  then
    log "ERROR: could not write cam-cleanup pending marker"
    return 1
  fi
  if ! mv "$tmp" "$CAM_CLEANUP_PENDING"
  then
    rm -f "$tmp"
    log "ERROR: could not publish cam-cleanup pending marker"
    return 1
  fi
  sync -f "$parent" >> "$LOG_FILE" 2>&1 || true
}

function clear_cam_cleanup_pending () {
  [ -e "$CAM_CLEANUP_PENDING" ] || return 0
  rm -f "$CAM_CLEANUP_PENDING" || true
  sync -f "${CAM_CLEANUP_PENDING%/*}" >> "$LOG_FILE" 2>&1 || true
}

function away_mode_active () {
  local flag="/mutable/sentryusb_away_mode.json"
  [ -f "$flag" ] || return 1
  # Automatic (geofence) mode: the flag file's existence IS the away
  # decision — the server writes it on leaving home and removes it on
  # arrival. There is no timer, so there is no remaining_sec to check.
  if grep -q '"mode":[[:space:]]*"auto"' "$flag" 2>/dev/null; then
    return 0
  fi
  # Manual timer: the server refreshes remaining_sec every 30s, so this
  # works with or without an RTC. Tolerate pretty-printed JSON — the Rust
  # server writes the flag with to_vec_pretty ("remaining_sec": 300), whose
  # space after the colon the old compact-JSON grep silently never matched.
  local remaining
  remaining=$(grep -o '"remaining_sec":[[:space:]]*[0-9]*' "$flag" | grep -o '[0-9]*$')
  [ -n "$remaining" ] && [ "$remaining" -gt 0 ] 2>/dev/null
}

function travel_mode_active () {
  # Travel Mode keeps the USB gadget presented to the car at all times: the
  # archive flow still snapshots and uploads, but every step that would
  # disconnect the gadget from the car is skipped. Read TRAVEL_MODE_ENABLED
  # FRESH on each call (like away_mode_active re-reads its flag) so the web-UI
  # toggle takes effect without restarting archiveloop. Search config paths in
  # the same order as sentryusb_config::find_config_path(); first existing wins.
  local conf val
  for conf in /root/sentryusb.conf /boot/firmware/sentryusb.conf /boot/sentryusb.conf
  do
    [ -f "$conf" ] || continue
    # Source in an isolated subshell so the value is parsed by bash itself
    # (handles export/quotes), exactly like envsetup.sh, with no side effects.
    val=$( set +eu; . "$conf" >/dev/null 2>&1; printf '%s' "${TRAVEL_MODE_ENABLED:-}" )
    case "${val,,}" in
      yes|true|1|on) return 0 ;;
    esac
    return 1
  done
  return 1
}

function travel_mode_interval () {
  # Cycle pacing for Travel Mode. Precedence: explicit TRAVEL_MODE_INTERVAL
  # (power-user env/conf override) > "half snapshots" menu toggle
  # (TRAVEL_MODE_HALF_SNAPSHOTS, read fresh like travel_mode_active so a
  # mid-trip toggle applies without restarting archiveloop) > the user's
  # SNAPSHOT_INTERVAL. Halving shrinks the window in which a full cam disk
  # can lose footage the car deletes before it was snapshotted + uploaded.
  if [ -n "${TRAVEL_MODE_INTERVAL:-}" ]; then
    echo "$TRAVEL_MODE_INTERVAL"
    return
  fi
  local base="${SNAPSHOT_INTERVAL:-3480}"
  local conf val
  for conf in /root/sentryusb.conf /boot/firmware/sentryusb.conf /boot/sentryusb.conf
  do
    [ -f "$conf" ] || continue
    val=$( set +eu; . "$conf" >/dev/null 2>&1; printf '%s' "${TRAVEL_MODE_HALF_SNAPSHOTS:-}" )
    case "${val,,}" in
      yes|true|1|on)
        echo $((base / 2))
        return
        ;;
    esac
    break
  done
  echo "$base"
}

function travel_mode_fast_retry_active () {
  # "Fast retry" menu toggle for intermittent uplinks (Starlink under a
  # bridge, cellular dead zones): when a Travel Mode archive cycle fails,
  # retry after a short delay instead of waiting out the full snapshot
  # interval. Read TRAVEL_MODE_FAST_RETRY fresh each call, exactly like
  # travel_mode_active, so the web-UI toggle applies without a restart.
  local conf val
  for conf in /root/sentryusb.conf /boot/firmware/sentryusb.conf /boot/sentryusb.conf
  do
    [ -f "$conf" ] || continue
    val=$( set +eu; . "$conf" >/dev/null 2>&1; printf '%s' "${TRAVEL_MODE_FAST_RETRY:-}" )
    case "${val,,}" in
      yes|true|1|on) return 0 ;;
    esac
    return 1
  done
  return 1
}

function travel_mode_retry_interval () {
  # Delay before a fast-retry attempt. TRAVEL_MODE_RETRY_INTERVAL is a
  # power-user env/conf override; clamp anything non-numeric or too small
  # to sane values so a bad override can't turn the loop into a hot spin.
  local v="${TRAVEL_MODE_RETRY_INTERVAL:-60}"
  case "$v" in
    ''|*[!0-9]*) v=60 ;;
  esac
  if [ "$v" -lt 15 ]; then v=15; fi
  echo "$v"
}

function travel_mode_pace () {
  # Travel Mode cycle pacing. The always-on VPN never goes unreachable, so
  # wait_for_archive_to_be_unreachable would block forever and halt
  # archiving — instead sleep a fixed interval and let the next iteration
  # take a fresh snapshot and archive its new clips. If the last cycle
  # failed and the fast-retry toggle is on, shrink the wait so a brief
  # uplink dropout (Starlink under a bridge) doesn't stall archiving for
  # the full snapshot interval.
  local interval
  if [ "${ARCHIVE_CYCLE_FAILED:-0}" = "1" ] && travel_mode_fast_retry_active; then
    interval=$(travel_mode_retry_interval)
    log "Travel Mode: last archive cycle failed, fast retry in ${interval}s"
  else
    interval=$(travel_mode_interval)
    log "Travel Mode: next snapshot+archive cycle in ${interval}s"
  fi

  # Sleep in short slices, watching for the manual-sync canary that
  # trigger-sync (POST /api/system/trigger-sync) drops. In normal mode the
  # canary unsticks the two reachability wait states, but Travel Mode
  # spends its idle time here instead — without this, "Start Archive"
  # would be a silent no-op until the interval expired. Consuming the
  # canary also keeps a stale one from faking a later reachability probe.
  local deadline=$((SECONDS + interval))
  local remaining slice
  while [ "$SECONDS" -lt "$deadline" ]; do
    if [ -e /tmp/archive_is_reachable ]; then
      if rm -f -- /tmp/archive_is_reachable; then
        log "Travel Mode: manual sync requested, starting the next cycle early"
        return 0
      fi
      log "Travel Mode: unable to consume manual sync request"
    fi
    remaining=$((deadline - SECONDS))
    slice=5
    if [ "$remaining" -lt "$slice" ]; then slice=$remaining; fi
    [ "$slice" -gt 0 ] && sleep "$slice"
  done
  return 0
}

function run_archive_cycle () {
  # Wrapper around archive_clips that owns the loop-level failure state.
  # ARCHIVE_RETRY_ATTEMPT must be derived from the PREVIOUS cycle's result
  # before it is cleared: it tells archive_teslacam_clips to suppress
  # per-attempt push notifications so minute-cadence fast retries don't
  # spam the phone (first failure and eventual success still notify).
  if [ "${ARCHIVE_CYCLE_FAILED:-0}" = "1" ] && travel_mode_active && travel_mode_fast_retry_active; then
    ARCHIVE_RETRY_ATTEMPT=1
  else
    ARCHIVE_RETRY_ATTEMPT=0
  fi
  ARCHIVE_CYCLE_FAILED=0
  archive_clips || ARCHIVE_CYCLE_FAILED=1
}

function wifi_cycle () {
  # This fix is only needed when ap0 exists.  ap0 shares the same physical
  # radio as wlan0 and locks it to the AP channel, preventing wlan0 from
  # scanning other channels to find the home network.  Without ap0,
  # NetworkManager handles reconnection on its own.
  if ! iw dev ap0 info &>/dev/null; then
    return
  fi

  log "Tearing down ap0 to free radio for wlan0 reconnect..."
  nmcli con down SENTRYUSB_AP 2>/dev/null || true
  iw dev ap0 del 2>/dev/null || true
  sleep 2

  # Disconnect and reconnect wlan0
  nmcli device disconnect wlan0 2>/dev/null || true
  sleep 2
  nmcli device connect wlan0 2>/dev/null || true

  # Wait up to 30 seconds for wlan0 to connect
  local i
  for i in $(seq 1 30); do
    local state
    state=$(nmcli -t -f DEVICE,STATE device status 2>/dev/null | grep "^wlan0:" | cut -d: -f2) || true
    if [ "${state:-}" = "connected" ]; then
      log "wlan0 reconnected after ${i}s"
      break
    fi
    sleep 1
  done

  # Recreate ap0 and bring the AP back ONLY while an Away Mode session is
  # active. In normal mode the whole point of the cycle is to remove ap0 so
  # wlan0 can scan — unconditionally re-upping the AP here used to resurrect
  # it after the user had disabled Away Mode.
  if away_mode_active; then
    if ! iw dev ap0 info &>/dev/null; then
      iw dev wlan0 interface add ap0 type __ap 2>/dev/null || true
    fi
    iw wlan0 set power_save off 2>/dev/null || true
    iw ap0 set power_save off 2>/dev/null || true
    nmcli con up SENTRYUSB_AP 2>/dev/null || true
  fi
}

function wait_for_archive_to_be_reachable () {
  log "Waiting for archive to be reachable..."
  local scan_counter=0
  while true
  do
    if archive_is_reachable
    then
      log "Archive is reachable."
      break
    fi
    if [ -e /tmp/archive_is_reachable ]
    then
      log "Simulating archive is reachable"
      rm /tmp/archive_is_reachable
      break
    fi
    # WiFi recovery while waiting for home network.
    # When Away Mode is active the AP has exclusive radio access — skip
    # all scanning and wifi_cycle so the AP stays up uninterrupted.
    scan_counter=$((scan_counter + 1))
    if ! away_mode_active; then
      # Normal mode: AP is off, scan freely
      if (( scan_counter % 30 == 0 )); then
        nmcli device wifi rescan 2>/dev/null || true
      fi
      # wifi_cycle only needed if ap0 somehow still exists
      if (( scan_counter % 300 == 0 )) && iw dev ap0 info &>/dev/null; then
        log "Archive still unreachable after ${scan_counter}s, cycling WiFi..."
        wifi_cycle
      fi
    else
      # Away Mode: skip all scanning, AP has exclusive radio access
      if (( scan_counter % 300 == 0 )); then
        log "Away Mode active, skipping WiFi scan/cycle"
      fi
    fi
    sleep 1
  done
}

function retry () {
  local attempts=0
  while true
  do
    if "$@"
    then
      true
      return
    fi
    if [ "$attempts" -ge 10 ]
    then
      log "Attempts exhausted."
      false
      return
    fi
    log "Sleeping before retry ..."
    /bin/sleep 1
    attempts=$((attempts + 1))
    log "Retrying ($attempts) '$*' ..."
  done
  false
  return
}

function ensure_mountpoint_is_mounted () {
  local mount_point="$1"

  if findmnt --mountpoint "$mount_point" > /dev/null
  then
    log "$mount_point is already mounted."
  else
    if timeout 10 mount "$mount_point" >> "$LOG_FILE" 2>&1
    then
      log "Mounted $mount_point."
    else
      log "Failed to mount $mount_point."
      return 1
    fi
  fi
}

function ensure_mountpoint_is_mounted_with_retry () {
  retry ensure_mountpoint_is_mounted "$1"
}

function ensure_cam_file_is_mounted () {
  log "Ensuring cam file is mounted..."
  disconnect_usb_drives_from_host
  ensure_mountpoint_is_mounted_with_retry "$CAM_MOUNT"
  log "Ensured cam file is mounted."
}

function ensure_music_file_is_mounted () {
