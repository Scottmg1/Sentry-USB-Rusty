# Write system time → RTC via /dev/rtc0 ioctl (Pi 5 only)
function rtc_sync_systohc () {
  [ -e /dev/rtc0 ] || return 1
  python3 -c "
import fcntl, struct, time
t = time.gmtime()
data = struct.pack('9i', t.tm_sec, t.tm_min, t.tm_hour, t.tm_mday, t.tm_mon-1, t.tm_year-1900, t.tm_wday, t.tm_yday, -1)
with open('/dev/rtc0', 'wb') as f:
    fcntl.ioctl(f.fileno(), 0x4024700a, data)
" 2>/dev/null
}

function set_time () {
  log "Trying to set time..."
  local -r uptime_start=$(awk '{print $1}' /proc/uptime)
  local -r clocktime_start=$(date +%s.%N)
  for _ in {1..5}
  do
    if ntpdig -S time.google.com || sntp -S 129.6.15.28
    # Fall back to NIST time server if DNS resolution fails (DNS over TLS & Cert is invalid because of wrong time)
    then
      local -r uptime_end=$(awk '{print $1}' /proc/uptime)
      local -r clocktime_end=$(date +%s.%N)
      log "$(awk "BEGIN {printf \"Time adjusted by %f seconds after %f seconds\", $clocktime_end-$clocktime_start, $uptime_end-$uptime_start}")"
      return
    fi
    log "sntp failed, retrying..."
    sleep 2
  done
  log "Failed to set time"
}

function timesyncloop {
  echo -n timesyncloop > /proc/self/comm
  while true
  do
    if ping -c 1 -W 3 time.google.com &>/dev/null || ping -c 1 -W 3 129.6.15.28 &>/dev/null; then
      set_time
      # Sync NTP-corrected time to RTC battery (Pi never shuts down gracefully)
      if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
        rtc_sync_systohc || true
      fi
    fi
    sleep "${TIME_SYNC_INTERVAL:-3600}"
  done
}

function snapshotloop {
  echo -n snapshotloop > /proc/self/comm
  while true
  do
    sleep "${SNAPSHOT_INTERVAL:-3480}"
    /root/bin/waitforidle || true
    /root/bin/make_snapshot.sh
    # Incrementally process new clips after each snapshot.
    # The processor skips already-processed files, so this is lightweight.
    # Runs in a subshell so the snapshot loop isn't blocked.
    if [ "${DRIVE_MAP_WHILE_AWAY:-false}" = "true" ]; then
      (
        SENTRYUSB_PORT="${SENTRYUSB_PORT:-80}"
        API_URL="http://127.0.0.1:${SENTRYUSB_PORT}"
        if curl -sf "${API_URL}/api/drives/status" > /dev/null 2>&1; then
          curl -sf -X POST "${API_URL}/api/drives/process?post_archive=1" \
            -H "Content-Type: application/json" \
            -d '{"clips_dir": "/mutable/TeslaCam/RecentClips", "throttle_ms": 30}' \
            > /dev/null 2>&1 || true
        fi
      ) &
    fi
  done
}

# True when the car has been reachable over BLE recently. Reads the
# telemetry daemon's once-a-minute heartbeat in /mutable/sentryusb-ble.log
# (state_age = seconds since the last successful BLE state sample). The
# heartbeat's own car= label is derived from cam_disk.bin mtime — the very
# signal the watchdog is judging — so it must NOT be used here (circular);
# state_age comes from the telemetry DB and is independent.
# No sqlite3 CLI exists on the Pi, hence log parsing instead of a DB query.
function car_is_awake_via_ble () {
  local f=/mutable/sentryusb-ble.log
  [ -f "$f" ] || return 1
  local now mt state_age
  now=$(date +%s)
  mt=$(stat --format=%Y "$f" 2>/dev/null) || return 1
  # Heartbeat itself stale => telemetry daemon down => awake state unknown.
  # Fail safe: report not-awake so the watchdog never cycles blind.
  (( now - mt < 180 )) || return 1
  state_age=$(tail -c 400 "$f" 2>/dev/null | tail -n 1 | sed -n 's/.*state_age=\([0-9]\{1,\}\)s.*/\1/p')
  [ -n "$state_age" ] && (( state_age <= 120 ))
}

# Snapshot everything a post-mortem needs BEFORE recovery destroys it.
# journald is volatile on these installs — this file on /mutable is the
# only place the kernel's view of a wedged gadget survives a reboot.
function dump_gadget_stall_evidence () {
  local out="$1"
  {
    echo "===== gadget stall evidence $(date) ====="
    echo "--- /sys/class/udc state ---"
    for u in /sys/class/udc/*/state; do echo "$u: $(cat "$u" 2>/dev/null)"; done
    echo "--- gadget configfs ---"
    echo "UDC: $(cat /sys/kernel/config/usb_gadget/sentryusb/UDC 2>/dev/null)"
    for l in /sys/kernel/config/usb_gadget/sentryusb/functions/mass_storage.0/lun.*/file; do
      echo "$l: $(cat "$l" 2>/dev/null)"
    done
    echo "--- cam_disk.bin ---"
    stat /backingfiles/cam_disk.bin 2>/dev/null
    echo "--- file-storage kernel thread io ---"
    for p in $(pgrep -f file-storage 2>/dev/null); do
      echo "pid $p:"; cat "/proc/$p/io" 2>/dev/null
    done
    echo "--- dmesg tail ---"
    dmesg | tail -150
  } > "$out" 2>&1 || true
}

# Detect the drive dying under the car and re-present it. On 2026-07-08 the
# car stopped writing mid-drive while configfs still reported the gadget
# bound; Tesla never retries a dropped drive on its own, so the outage
# lasted until the car power-cycled the USB port (~6 min). A disable/enable
# cycle re-enumerates the drive like a fresh plug and the car re-mounts it
# within seconds.
#
# Triggers (gadget must be bound, car must be awake via BLE):
#   1. UDC link state leaves "configured" and stays degraded >= 60s.
#   2. Car writes to cam_disk.bin were flowing this boot, then stopped
#      for >= GADGET_STALL_SECS (default 180) — and the archive is
#      UNREACHABLE. The reachability gate matters: at home, "car stopped
#      writing while awake" is what every normal arrival looks like once
#      the dashcam turns off, so trigger 2 would fire a false cycle +
#      notification on every drive home. Away from home (the incident
#      scenario) that pattern really is a stall. A real at-home stall is
#      still covered by trigger 1 plus the next archive cycle's own
#      gadget re-present.
# A car that is awake but legitimately not recording away from home can
# still trip trigger 2 once; the cycle is harmless then (drive idle,
# ~15s blip) and the rate limit keeps it from repeating.
function gadget_stall_watchdog () {
  echo -n gadgetwatchdog > /proc/self/comm
  local cam=/backingfiles/cam_disk.bin
  local stall_secs="${GADGET_STALL_SECS:-180}"
  # One cooldown between recovery cycles plus a hard per-boot cap: a real
  # stall needs one cycle; anything repeating is a deeper problem where
  # blind cycling just churns the car.
  local recovery_cooldown=600
  local max_recoveries=3
  local fresh_seen=0
  local udc_bad_since=0
  local last_recovery=0
  local recoveries=0
  local limit_logged=0

  while true
  do
    sleep "${GADGET_WATCHDOG_INTERVAL:-30}"

    # Only act while we intend to present the drive. During archiveloop's
    # own gadget-down windows (music sync, boot, lock-chime cycle) this is
    # false and the watchdog idles.
    if ! usb_gadget_is_active
    then
      fresh_seen=0
      udc_bad_since=0
      continue
    fi
    [ -f "$cam" ] || continue

    local now mtime age reason=""
    now=$(date +%s)
    mtime=$(stat --format=%Y "$cam" 2>/dev/null) || continue
    age=$(( now - mtime ))
    (( age < 90 )) && fresh_seen=1

    local udc_state
    udc_state=$(cat /sys/class/udc/*/state 2>/dev/null | head -1)
    if [ "$udc_state" = "configured" ] || [ -z "$udc_state" ]
    then
      udc_bad_since=0
    elif (( udc_bad_since == 0 ))
    then
      udc_bad_since=$now
    fi

    if [ -e /tmp/gadget_watchdog_force ]
    then
      rm -f /tmp/gadget_watchdog_force
      reason="forced via /tmp/gadget_watchdog_force (test hook)"
    elif ! car_is_awake_via_ble
    then
      continue
    elif (( udc_bad_since > 0 && now - udc_bad_since >= 60 ))
    then
      reason="UDC state '$udc_state' for $(( now - udc_bad_since ))s while car awake"
    elif (( fresh_seen == 1 && age >= stall_secs ))
    then
      # Home suppression for the write-stall trigger (see function header).
      # Reset fresh_seen so this doesn't re-probe reachability every 30s
      # until the car actually writes again.
      if archive_is_reachable
      then
        fresh_seen=0
        continue
      fi
      reason="car stopped writing for ${age}s while awake and away from home"
    else
      continue
    fi

    if (( recoveries >= max_recoveries ))
    then
      if (( limit_logged == 0 ))
      then
        limit_logged=1
        log "Gadget stall watchdog: $reason — but recovery limit reached (${max_recoveries}/boot), not cycling again this boot"
      fi
      continue
    fi
    if (( last_recovery > 0 && now - last_recovery < recovery_cooldown ))
    then
      continue
    fi

    local evidence="/mutable/gadget_stall_$(date +%Y%m%d_%H%M%S).log"
    log "Gadget stall watchdog: $reason — capturing evidence to $evidence, then re-presenting drive"
    dump_gadget_stall_evidence "$evidence"

    # Subshell exits 0 only when a cycle was actually attempted; a skip
    # (lock busy, state changed under the lock) exits 3 so the counters
    # and the push notification below don't fire for a non-event.
    if (
      # Bounded wait: if a gadget cycle elsewhere is wedged in an
      # uninterruptible configfs write (the very failure class this
      # watchdog targets), a plain flock would block forever and take
      # the watchdog down with it. Skip and retry next loop instead.
      if ! flock -w 60 209
      then
        log "Gadget stall watchdog: gadget lock busy for 60s, skipping recovery attempt"
        exit 3
      fi
      # Re-verify under the lock — the main loop may have legitimately
      # taken the gadget down between our decision and acquiring the lock.
      if usb_gadget_is_active \
         && ! findmnt --mountpoint "$CAM_MOUNT" > /dev/null \
         && ! findmnt --mountpoint "$MUSIC_MOUNT" > /dev/null
      then
        /root/bin/disable_gadget.sh || log "Gadget stall watchdog: disable_gadget failed (exit $?)"
        sleep 2
        if /root/bin/enable_gadget.sh
        then
          log "Gadget stall watchdog: drive re-presented to the car"
        else
          log "Gadget stall watchdog: ERROR enable_gadget failed (exit $?)"
        fi
      else
        log "Gadget stall watchdog: state changed before recovery could run, skipping cycle"
        exit 3
      fi
    ) 209>"$GADGET_CYCLE_LOCK"
    then
      /root/bin/send-push-message "$NOTIFICATION_TITLE:" \
        "USB drive stall detected ($reason). Re-presented the drive to the car. Evidence: $evidence" \
        warning gadget_stall 2>/dev/null || true
      last_recovery=$now
      recoveries=$((recoveries + 1))
      fresh_seen=0
      udc_bad_since=0
    fi
  done
}

# Mirror the kernel log to persistent storage. journald is volatile here,
# so without this a reboot destroys the only record of dwc2/mass-storage
# trouble (exactly what happened on 2026-07-08).
function kmsgmirror {
  echo -n kmsgmirror > /proc/self/comm
  local out=/mutable/kernel.log
  local n=0
  {
    echo "===== boot $(date) ====="
    dmesg --time-format iso 2>/dev/null || dmesg 2>/dev/null || true
  } >> "$out" 2>/dev/null || true
  # Trim right after the boot dump too — on a reboot-heavy box with a
  # quiet kernel the follow loop below may not see enough lines to ever
  # hit its size check, and repeated boot dumps would grow unbounded.
  if [[ "$(stat --format=%s "$out" 2>/dev/null)" -gt 2000000 ]] 2>/dev/null
  then
    tail -n 8000 "$out" > "${out}.2" 2>/dev/null && mv "${out}.2" "$out" 2>/dev/null || true
  fi
  { dmesg -W --time-format iso 2>/dev/null || dmesg -w 2>/dev/null; } | while IFS= read -r line
  do
    echo "$line" >> "$out" 2>/dev/null || true
    n=$((n + 1))
    if (( n % 200 == 0 )) && [[ "$(stat --format=%s "$out" 2>/dev/null)" -gt 2000000 ]] 2>/dev/null
    then
      tail -n 8000 "$out" > "${out}.2" 2>/dev/null && mv "${out}.2" "$out" 2>/dev/null || true
    fi
  done
}

function freespacemanager {
  echo -n freespacemanager > /proc/self/comm
  # 10G
  local reserve=10737418240
  local threepctoftotalspace
  threepctoftotalspace=$(eval "$(stat --file-system --format="echo \$((%b*%S/33))" /backingfiles/cam_disk.bin)")
  reserve=$((reserve+threepctoftotalspace))

  # Throttle marker for the storage-pressure push alert (once per 24h).
  local alert_marker=/run/sentryusb_storage_pressure_alerted
  local imutable ireserve ifree

  while true
  do
    # /mutable inode headroom threshold, mirroring manage_free_space.sh:
    # each retained clip costs a symlink inode in /mutable/TeslaCam, and
    # the inode table fills long before a multi-TB /backingfiles feels
    # block pressure (2026-08-19 field failure: 100% inode-full while
    # 71% of the bytes were free, ENOSPC on every ln/state write for a
    # day). max(20000, table/20) ≈ a week of links of recovery headroom.
    # Recomputed every cycle, not once at startup: /mutable can mount
    # after the service starts, and the rw requirement can change — on a
    # ro remount, releasing snapshots cannot delete their symlinks and
    # is pure footage loss, so the inode policy disarms.
    ireserve=0
    if findmnt -no OPTIONS --mountpoint /mutable 2>/dev/null | grep -qE '(^|,)rw(,|$)'
    then
      imutable=$(stat --file-system --format=%c /mutable 2>/dev/null || echo 0)
      if [ "$imutable" -gt 0 ]
      then
        ireserve=$((imutable / 20))
        if [ "$ireserve" -lt 20000 ]
        then
          ireserve=20000
        fi
      fi
    fi

    local freespace pressure=""
    freespace=$(eval "$(stat --file-system --format="echo \$((%f*%S))" /backingfiles/cam_disk.bin)")
    if [ "$freespace" -lt "$reserve" ]
    then
      pressure="free space low"
    fi
    if [ "$ireserve" -gt 0 ]
    then
      ifree=$(stat --file-system --format=%d /mutable 2>/dev/null || true)
      if [ -n "$ifree" ] && [ "$ifree" -le "$ireserve" ]
      then
        pressure="${pressure:+$pressure, }clip index nearly full"
      fi
    fi
    if [ -n "$pressure" ]
    then
      local relieved=true
      /root/bin/manage_free_space.sh "$reserve" || relieved=false
      # Alert when eviction failed outright, or when a standing inode
      # stall latch means the manager is deliberately no longer trying
      # (it exits 0 in that state, but the pressure is still real).
      # Recording or archiving may stop soon and most users never open
      # the dashboard — tell them directly, at most once a day. The
      # 2026-08-19 inode exhaustion ran silently for a day precisely
      # because nothing pushed.
      if [ "$relieved" = "false" ] || [ -e /run/sentryusb_inode_stall ]
      then
        if [ ! -e "$alert_marker" ] || \
           [ "$(( $(date +%s) - $(stat --format=%Y "$alert_marker" 2>/dev/null || echo 0) ))" -ge 86400 ]
        then
          touch "$alert_marker" 2>/dev/null || true
          /root/bin/send-push-message "${NOTIFICATION_TITLE:-SentryUSB}:" \
            "Storage pressure ($pressure) could not be relieved automatically. Recording or archiving may stop — check the dashboard." \
            warning storage_pressure 2>/dev/null || true
        fi
      fi
      if [ "$relieved" = "false" ]
      then
        sleep 30
      fi
    fi
    sleep 30
  done
}

function logrotator {
  echo -n logrotator > /proc/self/comm
  while true
  do
    if [ -s /var/log/nginx/access.log ]
    then
      mv -f /var/log/nginx/access.log /var/log/nginx/access.log.prev || true
    fi
    if [ -s /var/log/nginx/error.log ]
    then
      mv -f /var/log/nginx/error.log /var/log/nginx/error.log.prev || true
    fi
    if [ -e /var/run/nginx.pid ]
    then
      kill -USR1 "$(cat /var/run/nginx.pid)"
    fi
    sleep 1800
  done
}

function wifichecker {
  echo -n wifichecker > /proc/self/comm
  dmesg -w | {
    while TMOUT=1 read -r line
    do
      true
    done
    wifi=working
    while read -r line
    do
      case $line in
        *"failed to enable fw supplicant")
          if [ "$wifi" = "working" ]
          then
            wifi="notworking"
          else
            log "restarting wifi because of: $line"
            modprobe -r brcmfmac cfg80211 brcmutil || true
            modprobe brcmfmac || true
            while TMOUT=1 read -r line
            do
              true
            done
            wifi="working"
          fi
          ;;
        *)
          wifi=working
          ;;
      esac
    done
  }
}

function set_sys_param() {
  local -r parampath="$1"
  local -r var="$2"
  local -r defaultval="$3"

  local -r val=${!var:-$defaultval}
  if [[ ${val} = "default" ]]
  then
    log "not setting $parampath"
  else
    echo "$val" > "$parampath" || true
  fi
}

export -f ensure_mountpoint_is_mounted
export -f retry
export -f ensure_mountpoint_is_mounted_with_retry
export -f log

echo "==============================================" >> "$LOG_FILE"
log "Starting archiveloop at $(awk '{print $1}' /proc/uptime) seconds uptime..."

# One-line boot forensics: distinguishes a car power-cut from a PMIC
# brownout or watchdog reset when reconstructing an incident later.
# power_reset is a Pi 5 PMIC flag (all zeros = clean power-on); throttled
# bit 0 = undervoltage since boot.
log "Boot reason: power_reset=$(od -An -tx1 /proc/device-tree/chosen/power/power_reset 2>/dev/null | tr -d ' \n' || true) throttled=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2 || true)"

set_sys_param /proc/sys/vm/dirty_background_bytes DIRTY_BACKGROUND_BYTES 65536
set_sys_param /proc/sys/vm/dirty_ratio DIRTY_RATIO 80
set_sys_param /sys/devices/system/cpu/cpufreq/policy0/scaling_governor CPU_GOVERNOR conservative

/root/bin/temperature_monitor &

# The cam-disk workers used to be spawned only when cam_disk.bin existed
# at startup, so a late SSD enumeration (slow USB bridge, transient
# "SSD not found") left the service "active" for the whole boot with no
# snapshots, no free-space/inode management, and no gadget watchdog.
# Wait for the disk instead; when it is present at boot (the normal
# case) the workers start immediately, exactly as before.
#
# Supervise, don't just spawn: these workers are infinite loops, so any
# exit is abnormal (OOM kill, crash). Losing freespacemanager silently
# would re-open the very failure it watches for — links accumulating
# until /mutable is inode-full with the service still "active". Restart
# the trio together; the 10s pause keeps a crash-looping worker from
# spinning the CPU.
function camdiskworkers {
  echo -n camdiskworkers > /proc/self/comm
  until has_cam_disk
  do
    sleep 10
  done
  local snap_pid fsm_pid gsw_pid
  while true
  do
    snapshotloop &
    snap_pid=$!
    freespacemanager &
    fsm_pid=$!
    gadget_stall_watchdog &
    gsw_pid=$!
    # `|| true` is load-bearing: the script runs under -e, and wait -n
    # returns the dead worker's nonzero status — without the guard the
    # supervisor itself dies before it can log, reap, or restart.
    wait -n || true
    log "cam-disk worker exited unexpectedly; restarting snapshot/space/watchdog workers"
    kill "$snap_pid" "$fsm_pid" "$gsw_pid" 2>/dev/null || true
    wait 2>/dev/null || true
    sleep 10
  done
}

if ! has_cam_disk
then
  log "cam disk not present yet; snapshot/space/watchdog workers will start when it appears"
fi
camdiskworkers &
logrotator &
wifichecker &
timesyncloop &
kmsgmirror &

# Travel Mode crash-restart guard: the service runs with Restart=always, so
# any archiveloop crash re-enters this startup path with the system still in
# whatever state the crash left it. The configfs gadget survives process
# death — after a service restart (as opposed to a reboot) the car is still
# connected and writing through it. Running the normal startup sequence in
# that state would fsck-repair cam_disk.bin while the car writes to it (two
# writers on one block device), run a cleaning pass, and cycle the gadget:
# exactly the mid-trip disconnect Travel Mode exists to prevent. Skip it all
# and leave the gadget untouched — archiving reads snapshots, not the live
# image, so nothing downstream needs this. After a real reboot UDC is empty
# (usb_gadget_is_active fails), so the full sequence still runs and the car
# re-enumerates the drive as it always does after boot.
if travel_mode_active && usb_gadget_is_active
then
  log "Travel Mode: USB gadget still bound at startup (service restart) — keeping it connected; skipping boot-time fsck, cleaning and gadget cycle"
  # a crashed run may have left a stale in-progress marker
  clear_archive_status
  if has_cam_disk
  then
    # default (fsck) mode is safe here: it runs on the reflink copy, never
    # the live image — same as every mid-loop snapshot while the car records
    /root/bin/make_snapshot.sh || log "ERROR: make_snapshot.sh failed (exit $?)"
  fi
else
  fix_errors_in_images

  if has_cam_disk
  then
    # always remove files that fsck recoverd
    if [ -e "$CAM_CLEANUP_PENDING" ]
    then
      log "Completing cam cleanup deferred from an interrupted archive"
      clean_cam_mount freespace || log "ERROR: boot cam cleanup (freespace) failed"
    else
      clean_cam_mount boot || log "ERROR: boot cam cleanup failed"
    fi
  fi

  # Present the drive to the car BEFORE the boot snapshot. The snapshot is
  # a reflink copy of the live image — safe while the car writes, exactly
  # like every mid-loop snapshot — and taking it here used to cost the car
  # ~50 extra seconds without a drive on every power-on. The lock chime is
  # synced inside connect (before enable), so the car still sees a single
  # plug-in with everything already in place.
  connect_usb_drives_to_host || log "ERROR: boot USB connect failed"

  if has_cam_disk
  then
    # Snapshot immediately — no waitforidle. In sentry mode the car never
    # idles for the 5s gap, so waitforidle would burn its full 90s cap on
    # every boot AND widen the window in which the car can rotate away
    # clips before this snapshot captures them. A mid-write copy is fine:
    # make_snapshot fscks the copy (default mode), and a partial in-flight
    # clip was always possible across the power-loss boundary anyway.
    /root/bin/make_snapshot.sh || log "ERROR: boot make_snapshot.sh failed (exit $?)"
  fi
fi

if archive_is_reachable
then
  fastblink

  set_time

  # Seed RTC with NTP-corrected time on first boot
  if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
    rtc_sync_systohc || true
  fi

  # A large clock step can cause NetworkManager to drop the WiFi
  # connection (it thinks the DHCP lease expired). Re-verify and recover.
  if ! archive_is_reachable; then
    log "Network lost after time adjustment, waiting for recovery..."
    wait_for_archive_to_be_reachable
  fi

  # Travel Mode: skip keep-awake. On the road the car is driving or in
  # Sentry (won't sleep), so it's unnecessary. awake_stop is NOT gated:
  # it is Travel Mode-aware internally (skips the Sentry-OFF command,
  # still reaps the nudge loop / BLE lock), so calling it unconditionally
  # covers the case where Travel Mode was enabled mid-cycle after
  # awake_start already spawned the nudge loop.
  if ! travel_mode_active; then
    /root/bin/awake_start || true
  fi

  run_archive_cycle

  /root/bin/awake_stop || true

  doubleblink

  # archive_clips already ensured when needed; do not force another full cycle.
  if archive_is_reachable && ! travel_mode_active; then
    ensure_usb_drives_connected || log "ERROR: failed to ensure USB gadget after archive cycle"
  fi

  if travel_mode_active; then
    travel_mode_pace
  elif archive_is_reachable; then
    wait_for_archive_to_be_unreachable
  fi
fi

while true
do
  slowblink

  wait_for_archive_to_be_reachable

  fastblink

  set_time

  # Sync NTP-corrected time to RTC battery
  if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
    rtc_sync_systohc || true
  fi

  # A large clock step can cause NetworkManager to drop the WiFi
  # connection (it thinks the DHCP lease expired). Re-verify and recover.
  if ! archive_is_reachable; then
    log "Network lost after time adjustment, waiting for recovery..."
    wait_for_archive_to_be_reachable
  fi

  # Travel Mode: skip keep-awake; awake_stop stays unconditional
  # (see rationale at the first archive above).
  if ! travel_mode_active; then
    /root/bin/awake_start || true
  fi

  sleep "${ARCHIVE_DELAY:-20}"

  # take a snapshot before archive_clips starts deleting files
  if has_cam_disk
  then
    if ! /root/bin/make_snapshot.sh; then
      log "ERROR: make_snapshot.sh failed (exit $?)"
    fi
  fi

  run_archive_cycle

  /root/bin/awake_stop || true

  doubleblink

  if archive_is_reachable && ! travel_mode_active; then
    ensure_usb_drives_connected || log "ERROR: failed to ensure USB gadget after archive cycle"
  fi

  if travel_mode_active; then
    travel_mode_pace
  elif archive_is_reachable; then
    wait_for_archive_to_be_unreachable
  fi

  check_if_usb_gadget_is_mounted
done
